<section class="pagehead">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <% if (activeCategory) { %>
        <a href="/inventory">Inventory</a><span class="sep">›</span>
        <span class="current"><%= activeCategory.name %></span>
      <% } else { %>
        <span class="current">All vehicles</span>
      <% } %>
    </nav>
    <div class="eyebrow">Current stock</div>
    <h1 class="h1" style="margin-top:8px">
      <%= activeCategory ? activeCategory.name : 'Vehicle inventory' %>
    </h1>
    <p class="lede">
      <%= activeCategory && activeCategory.description
          ? activeCategory.description
          : 'Browse everything on the block — filter by make, model, year, mileage and price.' %>
    </p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <form method="get" action="/inventory" class="searchbar">
      <%- include('../partials/icons', { icon: 'search', strokeWidth: 2 }) %>
      <input class="input" type="search" name="q" value="<%= filters.q %>"
             placeholder="Search by title, make, model, trim, year, VIN or stock number…"
             aria-label="Search inventory">
      <% ['category','make','sort','filter','price_min','price_max','condition','mileage_max'].forEach(function (k) { %>
        <% if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% } %>
      <% }); %>
    </form>

    <div class="inv-layout">
      <!-- Filters -->
      <aside class="filters">
        <details class="filters-collapse" open data-filters>
          <summary class="filters-toggle">
            <span>Filter vehicles</span>
            <span class="chev">+</span>
          </summary>
        <div class="filters-inner">
          <div class="filters-head">
            <span>Filters</span>
            <% if (Object.keys(query).length) { %><a href="/inventory">Clear all</a><% } %>
          </div>

          <div class="filter-group">
            <div class="filter-title">Category</div>
            <div class="filter-list">
              <a href="/inventory<%= buildQuery({ category: '', page: '' }) %>"
                 class="<%= !filters.category ? 'is-active' : '' %>">
                <span>All vehicles</span><span class="n"><%= liveCount %></span>
              </a>
              <% categories.forEach(function (c) { %>
                <a href="/inventory<%= buildQuery({ category: c.slug, page: '' }) %>"
                   class="<%= filters.category === c.slug ? 'is-active' : '' %>">
                  <span><%= c.name %></span><span class="n"><%= c.listing_count %></span>
                </a>
              <% }); %>
            </div>
          </div>

          <form method="get" action="/inventory">
            <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
            <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>

            <div class="filter-group">
              <div class="filter-title">Make</div>
              <select class="select" name="make">
                <option value="">All makes</option>
                <% facets.makes.forEach(function (m) { %>
                  <option value="<%= m.make %>" <%= filters.make === m.make ? 'selected' : '' %>>
                    <%= m.make %> (<%= m.n %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="filter-group">
              <div class="filter-title">Model</div>
              <select class="select" name="model">
                <option value="">All models</option>
                <% facets.models.forEach(function (m) { %>
                  <option value="<%= m.model %>" <%= filters.model === m.model ? 'selected' : '' %>>
                    <%= m.make %> <%= m.model %>
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="filter-group">
              <div class="filter-title">Fuel &amp; title</div>
              <select class="select" name="fuel_type" style="margin-bottom:10px">
                <option value="">Any fuel</option>
                <% (facets.fuels || []).forEach(function (f) { %>
                  <option value="<%= f.fuel_type %>" <%= filters.fuelType === f.fuel_type ? 'selected' : '' %>>
                    <%= f.fuel_type %> (<%= f.n %>)
                  </option>
                <% }); %>
              </select>
              <select class="select" name="title_status">
                <option value="">Any title</option>
                <% (facets.titles || []).forEach(function (t) { %>
                  <option value="<%= t.title_status %>" <%= filters.titleStatus === t.title_status ? 'selected' : '' %>>
                    <%= t.title_status %> (<%= t.n %>)
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="filter-group">
              <div class="filter-title">Year</div>
              <div class="field-row">
                <select class="select" name="year_min" aria-label="Minimum year">
                  <option value="">From</option>
                  <% facets.years.forEach(function (y) { %>
                    <option value="<%= y %>" <%= String(filters.yearMin) === String(y) ? 'selected' : '' %>><%= y %></option>
                  <% }); %>
                </select>
                <select class="select" name="year_max" aria-label="Maximum year">
                  <option value="">To</option>
                  <% facets.years.forEach(function (y) { %>
                    <option value="<%= y %>" <%= String(filters.yearMax) === String(y) ? 'selected' : '' %>><%= y %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div class="filter-group">
              <div class="filter-title">Price range</div>
              <div class="field-row">
                <div class="input-money">
                  <input class="input" type="text" inputmode="numeric" name="price_min"
                         value="<%= filters.priceMin %>" placeholder="Min" aria-label="Minimum price">
                </div>
                <div class="input-money">
                  <input class="input" type="text" inputmode="numeric" name="price_max"
                         value="<%= filters.priceMax %>" placeholder="Max" aria-label="Maximum price">
                </div>
              </div>
              <% if (facets.priceRange && facets.priceRange.min) { %>
                <p class="hint">Stock ranges <%= money.formatShort(facets.priceRange.min) %>–<%= money.formatShort(facets.priceRange.max) %></p>
              <% } %>
            </div>

            <div class="filter-group">
              <div class="filter-title">Maximum mileage</div>
              <select class="select" name="mileage_max">
                <option value="">Any mileage</option>
                <% [15000, 30000, 50000, 75000, 100000, 150000].forEach(function (m) { %>
                  <option value="<%= m %>" <%= String(query.mileage_max) === String(m) ? 'selected' : '' %>>
                    Under <%= m.toLocaleString('en-US') %> miles
                  </option>
                <% }); %>
              </select>
            </div>

            <div class="filter-group">
              <div class="filter-title">Condition</div>
              <label class="check" style="margin-bottom:9px">
                <input type="radio" name="condition" value="" <%= !filters.condition ? 'checked' : '' %>>
                <span>Any condition</span>
              </label>
              <label class="check" style="margin-bottom:9px">
                <input type="radio" name="condition" value="used" <%= filters.condition === 'used' ? 'checked' : '' %>>
                <span>Used</span>
              </label>
              <label class="check">
                <input type="radio" name="condition" value="new" <%= filters.condition === 'new' ? 'checked' : '' %>>
                <span>New</span>
              </label>
            </div>

            <div class="filter-group">
              <label class="check">
                <input type="checkbox" name="filter" value="auction" <%= filters.onlyAuctions ? 'checked' : '' %>>
                <span>Live auctions only</span>
              </label>
            </div>

            <button type="submit" class="btn btn-dark btn-block mt-2">Apply filters</button>
            <a href="/inventory" class="btn btn-ghost btn-block mt-1">Clear all</a>
          </form>
        </div>
        </details>
      </aside>

      <!-- Results -->
      <div>
        <div class="toolbar">
          <div>
            <strong class="mono"><%= total %></strong>
            <span class="muted"><%= total === 1 ? 'vehicle' : 'vehicles' %> found</span>
            <% if (totalPages > 1) { %>
              <span class="muted small"> · page <%= page %> of <%= totalPages %></span>
            <% } %>
          </div>

          <form method="get" action="/inventory" class="row" style="gap:8px">
            <% Object.keys(query).forEach(function (k) { %>
              <% if (k !== 'sort' && k !== 'page' && query[k]) { %>
                <input type="hidden" name="<%= k %>" value="<%= query[k] %>">
              <% } %>
            <% }); %>
            <label class="xsmall muted" for="sort" style="white-space:nowrap">Sort by</label>
            <select class="select" name="sort" id="sort" style="width:auto;min-width:180px" onchange="this.form.submit()">
              <% sortOptions.forEach(function (opt) { %>
                <option value="<%= opt[0] %>" <%= filters.sort === opt[0] ? 'selected' : '' %>><%= opt[1] %></option>
              <% }); %>
            </select>
          </form>
        </div>

        <% const activeChips = [];
           if (filters.q) activeChips.push(['q', 'Search: ' + filters.q]);
           if (filters.category && activeCategory) activeChips.push(['category', activeCategory.name]);
           if (filters.make) activeChips.push(['make', filters.make]);
           if (filters.yearMin) activeChips.push(['year_min', 'From ' + filters.yearMin]);
           if (filters.yearMax) activeChips.push(['year_max', 'To ' + filters.yearMax]);
           if (filters.priceMin) activeChips.push(['price_min', 'Min $' + filters.priceMin]);
           if (filters.priceMax) activeChips.push(['price_max', 'Max $' + filters.priceMax]);
           if (query.mileage_max) activeChips.push(['mileage_max', 'Under ' + Number(query.mileage_max).toLocaleString('en-US') + ' mi']);
           if (filters.condition) activeChips.push(['condition', filters.condition]);
           if (filters.onlyAuctions) activeChips.push(['filter', 'Live auctions only']);
        %>
        <% if (activeChips.length) { %>
          <div class="chips mb-3">
            <% activeChips.forEach(function (chip) { %>
              <a class="chip" href="/inventory<%= buildQuery({ [chip[0]]: '', page: '' }) %>">
                <%= chip[1] %> <span class="x">×</span>
              </a>
            <% }); %>
          </div>
        <% } %>

        <% if (listings.length) { %>
          <div class="board-grid">
            <% listings.forEach(function (lot) { %>
              <%- include('../partials/lot-card', { lot: lot }) %>
            <% }); %>
          </div>

          <% if (totalPages > 1) { %>
            <nav class="pagination" aria-label="Pagination">
              <a href="/inventory<%= buildQuery({ page: page - 1 }) %>"
                 class="<%= page <= 1 ? 'is-disabled' : '' %>" aria-label="Previous page">‹</a>
              <%
                let from = Math.max(1, page - 2);
                let to = Math.min(totalPages, from + 4);
                from = Math.max(1, to - 4);
              %>
              <% if (from > 1) { %>
                <a href="/inventory<%= buildQuery({ page: 1 }) %>">1</a>
                <% if (from > 2) { %><span class="is-disabled">…</span><% } %>
              <% } %>
              <% for (let p = from; p <= to; p++) { %>
                <% if (p === page) { %>
                  <span class="is-current"><%= p %></span>
                <% } else { %>
                  <a href="/inventory<%= buildQuery({ page: p }) %>"><%= p %></a>
                <% } %>
              <% } %>
              <% if (to < totalPages) { %>
                <% if (to < totalPages - 1) { %><span class="is-disabled">…</span><% } %>
                <a href="/inventory<%= buildQuery({ page: totalPages }) %>"><%= totalPages %></a>
              <% } %>
              <a href="/inventory<%= buildQuery({ page: page + 1 }) %>"
                 class="<%= page >= totalPages ? 'is-disabled' : '' %>" aria-label="Next page">›</a>
            </nav>
          <% } %>
        <% } else { %>
          <div class="empty card">
            <%- include('../partials/icons', { icon: 'search', strokeWidth: 1.2 }) %>
            <h3 class="h3">Nothing matches those filters</h3>
            <p class="muted mt-1" style="max-width:44ch;margin-inline:auto">
              Try widening the price range or clearing a filter. If you are after
              something specific, call us — we source to order.
            </p>
            <div class="row center mt-3" style="justify-content:center">
              <a href="/inventory" class="btn btn-primary btn-inline">Clear filters</a>
              <a href="/contact" class="btn btn-ghost btn-inline">Tell us what you need</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

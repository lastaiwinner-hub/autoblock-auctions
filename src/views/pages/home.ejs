<% const second = featured.find(l => l.primary_image) || endingSoon.find(l => l.primary_image); %>
<section class="showcase" aria-labelledby="showcase-title">
  <div class="wrap showcase-grid">
    <div class="showcase-copy">
      <div class="eyebrow"><span class="status-point"></span> Good cars. A better way to buy.</div>
      <h1 id="showcase-title">Your next chapter.<br><em>On four wheels.</em></h1>
      <p>From the daily drive to the one you’ve always wanted. Explore the inventory, find your fit, and bid on your terms.</p>
      <div class="showcase-actions">
        <a href="/inventory?filter=auction" class="btn btn-hot btn-lg">Explore live auctions <span aria-hidden="true">↗</span></a>
        <a href="/how-it-works" class="text-link">How it works <span aria-hidden="true">→</span></a>
      </div>
      <div class="showcase-proof">
        <div><strong><%= stats.live %></strong><span>vehicles listed</span></div>
        <div><strong><%= brand.terms.buyerPremiumPercent %>%</strong><span>buyer premium</span></div>
        <div><strong><%= brand.terms.inspectionDays %> days</strong><span>inspection window</span></div>
      </div>
    </div>
    <figure class="showcase-photo">
      <img src="/img/editorial-hero.webp" alt="Silver BMW coupe photographed outdoors" width="1600" height="1200" fetchpriority="high">
      <div class="photo-topline"><span>For the love of the drive</span><span aria-hidden="true">↗</span></div>
      <figcaption><span>Real photography. Representative image.</span><a href="/photo-credits">Photo credit ↗</a></figcaption>
    </figure>
  </div>
</section>
<section class="discovery" aria-label="Find vehicles">
  <div class="wrap">
    <form action="/inventory" method="get" class="discovery-form">
      <div class="field"><label for="home-query">Find your next drive</label><input class="input" id="home-query" type="search" name="q" placeholder="Make, model or stock number"></div>
      <div class="field"><label for="home-make">Make</label><select class="select" name="make" id="home-make"><option value="">All makes</option><% facets.makes.forEach(m => { %><option value="<%= m.make %>"><%= m.make %> (<%= m.n %>)</option><% }); %></select></div>
      <div class="field"><label for="home-category">Body type</label><select class="select" name="category" id="home-category"><option value="">All types</option><% categories.forEach(c => { %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select></div>
      <button class="btn btn-primary" type="submit"><%- include('../partials/icons', { icon: 'search' }) %> Search inventory</button>
    </form>
    <nav class="category-links" aria-label="Browse vehicles by type"><a href="/inventory" class="category-all">All inventory <span>↗</span></a><% categories.forEach(c => { %><a href="/inventory?category=<%= c.slug %>"><%= c.name %><span><%= c.listing_count %></span></a><% }); %></nav>
  </div>
</section>
<section class="market-section">
  <div class="wrap">
    <div class="market-heading"><div><span class="eyebrow">The auction floor</span><h2>Next to go.</h2></div><a href="/inventory?filter=auction" class="text-link">All live auctions <span aria-hidden="true">↗</span></a></div>
    <div class="market-context"><span><span class="status-point"></span> <%= stats.auctions %> live auctions</span><span>Browse. Compare. Make your move.</span></div>
    <% if (endingSoon.length) { %>
      <div class="market-grid"><% endingSoon.slice(0, 6).forEach(lot => { %><%- include('../partials/lot-card', { lot: lot }) %><% }); %></div>
    <% } else { %><div class="empty panel"><h3>No live auctions right now</h3><p class="muted">Explore available vehicles or sign up for inventory alerts.</p><a href="/inventory" class="btn btn-primary mt-2">Browse inventory</a></div><% } %>
    <p class="catalogue-note">Catalogue photography is illustrative where credited. Check the listing details and request current item photographs before bidding. <a href="/photo-credits">View photography credits.</a></p>
  </div>
</section>
<!-- ================= WHY US ================= -->
<section class="section section-white">
  <div class="wrap">
    <div class="split">
      <% if (second) { %>
        <img src="/uploads/listings/<%= second.primary_image %>" alt="<%= second.title %>" loading="lazy" width="800" height="640">
      <% } %>
      <div class="split-body">
        <span class="eyebrow">Why <%= brand.shortName %></span>
        <h2 class="h2" style="margin:10px 0 14px">Built for buying<br>sight-unseen.</h2>
        <p class="lede" style="font-size:.98rem">
          Buying a car online only works if the seller removes the risk. So we
          did — inspection, verification, paperwork and delivery all sit on our
          side of the deal.
        </p>

        <ul class="ticks">
          <li><span class="box">✓</span><span>Review the listed mileage, condition and disclosed faults before making a decision</span></li>
          <li><span class="box">✓</span><span>Title status disclosed before you bid and printed on your agreement</span></li>
          <li><span class="box">✓</span><span><%= brand.terms.inspectionDays %>-day money back — take it to your own mechanic</span></li>
        </ul>

        <div class="row" style="gap:9px">
          <a href="/about" class="btn btn-primary btn-inline">About us</a>
          <a href="/contact" class="btn btn-ghost btn-inline">Contact sales</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="section section-alt">
  <div class="wrap">
    <div class="row-between mb-3">
      <div>
        <span class="eyebrow">How it works</span>
        <h2 class="h2" style="margin-top:8px">From browsing<br>to your driveway</h2>
      </div>
      <a href="/how-it-works" class="btn btn-ghost btn-inline">Full process</a>
    </div>

    <div class="process">
      <% [
        { n: '01', t: 'Browse', d: 'Every listing carries photographs, mileage, title status, options and an honest description.' },
        { n: '02', t: 'Verify', d: 'Register free and clear ID once — front, back and a selfie. Cleared in hours.' },
        { n: '03', t: 'Bid or buy', d: 'Set a maximum and we bid for you in single increments, or take it now at the Buy Now price.' },
        { n: '04', t: 'Sign and drive', d: 'Your agreement is issued the second you bid, signed digitally, then delivered with the title.' }
      ].forEach(function (s) { %>
        <div class="pcard">
          <div class="n"><%= s.n %></div>
          <h3><%= s.t %></h3>
          <p><%= s.d %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ================= COMMON QUESTIONS ================= -->
<section class="section section-white">
  <div class="wrap">
    <div class="grid questions-grid">
      <div>
        <span class="eyebrow">Before you bid</span>
        <h2 class="h2" style="margin:8px 0 14px">Common<br>questions</h2>
        <p class="lede">
          Bidding, verification, payment, the <%= brand.terms.inspectionDays %>-day
          inspection window, titles and delivery.
        </p>
        <a href="/faq" class="btn btn-primary mt-3 btn-inline">Read the full FAQ</a>
      </div>

      <div class="card card-pad">
        <% homeFaq.forEach(function (item, i) { %>
          <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
            <summary class="faq-q">
              <%= item.q %>
              <span class="icon"><%- include('../partials/icons', { icon: 'plus', strokeWidth: 2.4 }) %></span>
            </summary>
            <div class="faq-a"><%= item.a %></div>
          </details>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<!-- ================= ALERTS ================= -->
<section class="alerts" id="alerts">
  <div class="wrap">
    <div>
      <h3>Tell us what you are hunting for</h3>
      <p>We email you the moment a matching vehicle is listed — before it opens for bidding.</p>
    </div>
    <form method="post" action="/alerts" class="row">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input" type="text" name="wanted" placeholder="e.g. 4x4 diesel pickup under 80,000 miles"
             aria-label="What you are looking for" style="min-width:300px">
      <input class="input" type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
      <button type="submit" class="btn btn-hot btn-inline">Get alerts</button>
    </form>
  </div>
</section>

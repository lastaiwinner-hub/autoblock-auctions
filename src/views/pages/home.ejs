<% const shelf=endingSoon.slice(0,9); const cover=endingSoon.find(l=>l.make==='BMW') || endingSoon[0]; %>
<section class="exchange-intro wrap"><div><span class="exchange-kicker">THE ONLINE VEHICLE AUCTION MARKETPLACE</span><h1>Your next vehicle.<br><span>Your winning bid.</span></h1><p>Explore the details. Set your limit. Bid with confidence.</p></div><div class="exchange-stats"><div><strong><%= stats.auctions %></strong><span>Live auctions</span></div><div><strong><%= brand.terms.buyerPremiumPercent %>%</strong><span>Buyer premium</span></div><a href="/how-it-works"><%- include('../partials/icons',{icon:'gavel'}) %>New to bidding?<b>Here’s how it works ↗</b></a></div></section>
<section class="exchange-stage wrap">
<% if(cover){ const cd=dates.countdown(cover.auction_ends_at); %><article class="exchange-feature" data-auction="<%= cover.slug %>"><a class="exchange-feature-image" href="/lot/<%= cover.slug %>"><img src="/uploads/listings/<%= cover.primary_image %>" alt="<%= cover.title %> — catalogue photograph" width="1000" height="650" fetchpriority="high"><span class="exchange-feature-tag"><%- include('../partials/icons',{icon:'gavel'}) %>FEATURED AUCTION</span></a><div class="exchange-feature-info"><div><span class="exchange-kicker"><%= cover.category_name %> / <%= cover.year %></span><h2><a href="/lot/<%= cover.slug %>"><%= cover.title %></a></h2><p><%= Number(cover.mileage||0).toLocaleString('en-US') %> miles · <%= cover.fuel_type %> · <%= cover.transmission %></p></div><div class="exchange-feature-bid"><div><span data-auction-price-caption>Current bid</span><strong data-auction-price><%= money.formatShort(cover.current_bid||cover.starting_bid) %></strong><small><b data-auction-bids><%= cover.bid_count||0 %></b> bids</small></div><div class="exchange-feature-clock" data-countdown="<%= cover.auction_ends_at %>"><span>Time remaining</span><strong data-countdown-label><%= cd.label %></strong></div><a class="action action-bid" data-auction-link href="/lot/<%= cover.slug %>#bidding">View auction <span>↗</span></a></div></div></article><% }else{ %><div class="exchange-empty"><h2>The next lineup is on its way.</h2><a href="/inventory">Browse inventory →</a></div><% } %>
<aside class="exchange-closing"><div class="exchange-closing-title"><span class="live-dot"></span><h2>Next to close</h2><%- include('../partials/icons',{icon:'clock'}) %></div><p>Keep your next opportunity in sight.</p><% endingSoon.slice(0,3).forEach(lot=>{const cd=dates.countdown(lot.auction_ends_at); %><a class="closing-lot" href="/lot/<%= lot.slug %>" data-auction="<%= lot.slug %>"><img src="/uploads/listings/<%= lot.primary_image %>" alt="" width="130" height="95"><div><h3><%= lot.title %></h3><strong data-auction-price><%= money.formatShort(lot.current_bid||lot.starting_bid) %></strong><span data-countdown="<%= lot.auction_ends_at %>"><span data-countdown-label><%= cd.label %></span></span></div><span class="closing-arrow">↗</span></a><% }); %><a class="closing-all" href="/inventory?filter=auction">Browse all live auctions <span>→</span></a></aside>
</section>
<div class="exchange-benefits wrap"><span><%- include('../partials/icons',{icon:'shield'}) %><%= brand.terms.inspectionDays %>-day inspection window</span><span><%- include('../partials/icons',{icon:'clipboard'}) %>Detailed vehicle information</span><span><%- include('../partials/icons',{icon:'truck'}) %>Delivery coordination</span><a href="/account/watchlist"><%- include('../partials/icons',{icon:'heart'}) %>Build your watchlist ↗</a></div>
<section class="exchange-search wrap"><div><h2>Find your next auction</h2><span>Search the current inventory</span></div><form class="auction-search discovery-form" action="/inventory" method="get"><div class="search-query"><%- include('../partials/icons',{icon:'search'}) %><label class="sr-only" for="home-query">Search vehicles</label><input id="home-query" name="q" type="search" placeholder="Search make, model, or keyword…"></div><div><label class="sr-only" for="home-make">Make</label><select id="home-make" name="make"><option value="">All makes</option><% facets.makes.forEach(m=>{ %><option value="<%= m.make %>"><%= m.make %></option><% }); %></select></div><div><label class="sr-only" for="home-category">Category</label><select id="home-category" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select></div><button class="action action-dark" type="submit">Find vehicles <span aria-hidden="true">→</span></button></form></section>
<div class="exchange-body-types wrap" aria-label="Vehicle categories"><a href="/inventory">All vehicles</a><% categories.slice(0,6).forEach(c=>{ %><a href="/inventory?category=<%= c.slug %>"><%- include('../partials/icons',{icon:c.icon||'car'}) %><%= c.name %><small><%= c.listing_count %></small></a><% }); %></div>
<section class="auction-market" id="live-auctions"><div class="wrap"><div class="market-title"><div><span class="exchange-kicker">BROWSE. COMPARE. BID.</span><h2>Live vehicle auctions</h2></div><a class="link-arrow" href="/inventory">Explore all vehicles ↗</a></div> <div class="auction-toolbar"><div class="auction-tabs" aria-label="Filter featured auctions"><button type="button" class="is-active" data-auction-filter="all" aria-pressed="true">All auctions <span><%= shelf.length %></span></button><button type="button" data-auction-filter="ending" aria-pressed="false">Ending today</button><button type="button" data-auction-filter="no-reserve" aria-pressed="false">No reserve</button><button type="button" data-auction-filter="popular" aria-pressed="false">Most bids</button></div><span class="sync-label" data-auction-sync><span class="live-dot"></span> Auction overview</span></div>
 <% if(shelf.length) { %><div class="auction-grid market-grid" data-auction-grid><% shelf.forEach(lot=>{ %><%- include('../partials/auction-card',{lot}) %><% }); %></div><div class="filter-empty" hidden data-filter-empty><h3>No matching auctions in this selection.</h3><a href="/inventory" class="link-arrow">Explore the full inventory →</a></div><% } else { %><div class="filter-empty"><h3>No live auctions right now</h3><p>Browse available vehicles or sign up for new listing alerts.</p><a href="/inventory" class="action action-dark">Explore inventory</a></div><% } %>
 <div class="market-bottom"><p>Catalogue images may be representative. <a href="/photo-credits">Photography details</a></p><a href="/inventory?filter=auction" class="action action-outline">See all live auctions <span>↗</span></a></div>
</div></section>


<section class="exchange-guide wrap"><div class="exchange-guide-intro"><span class="exchange-kicker">YOUR FIRST AUCTION?</span><h2>Ready when<br>you are.</h2><p>A straightforward path from finding a vehicle to making it yours.</p><a href="/how-it-works">The complete buying guide ↗</a></div><% [{i:'user',n:'01',t:'Create your account',d:'Register and complete identity verification to get ready to bid.'},{i:'search',n:'02',t:'Do your homework',d:'Review the photos, specifications, condition details and buying terms.'},{i:'gavel',n:'03',t:'Place your bid',d:'Bid directly or set a maximum. Follow the closing time and auction updates.'},{i:'truck',n:'04',t:'Make it yours',d:'Complete your agreement and coordinate delivery with the team.'}].forEach(step=>{ %><article><div><%- include('../partials/icons',{icon:step.i}) %><span><%= step.n %></span></div><h3><%= step.t %></h3><p><%= step.d %></p></article><% }); %></section>
<section class="exchange-help wrap"><div><%- include('../partials/icons',{icon:'phone'}) %><div><h2>Real questions. Real support.</h2><p>Talk through a vehicle, the bidding process or delivery.</p></div><a href="tel:<%= brand.contact.phoneHref %>"><%= brand.contact.phone %> ↗</a></div><a href="/faq">Visit the auction help centre →</a></section>
<section class="newsletter-section" id="alerts"><div class="wrap newsletter-inner"><div><span class="section-kicker">DON’T MISS YOUR NEXT OPPORTUNITY</span><h2>The next great find.<br>Before it gets away.</h2><p>Tell us what you’re looking for. We’ll keep you in the loop.</p></div><form method="post" action="/alerts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="wanted">What’s on your list?</label><input id="wanted" name="wanted" placeholder="e.g. A 4×4 pickup or weekend coupe"><label for="alert-email">Email address</label><div class="subscribe-row"><input id="alert-email" name="email" type="email" placeholder="you@example.com" required><button type="submit" class="action action-accent">Keep me posted ↗</button></div></form></div></section>

<% const shelf = endingSoon.slice(0,6); const cover = featured.find(l=>l.make==='BMW') || featured[0] || endingSoon[0]; %>
<section class="drive-cover">
 <img src="/img/brand-hero.webp" class="drive-cover-photo" alt="Sports coupe on an open desert road" width="1800" height="1000" fetchpriority="high">
 <div class="wrap drive-cover-copy"><span class="drive-label">THE NEXT CHAPTER IS YOURS</span><h1>Good cars.<br><em>Great possibilities.</em></h1><p>For the everyday. For the escape.<br>Find a vehicle worth making yours.</p><a class="drive-pill" href="#live-auctions">Explore the auctions <span>↗</span></a></div>
 <div class="wrap drive-cover-foot"><span>THE OPEN ROAD STARTS HERE</span><a href="/photo-credits">Real photography. Full credits ↗</a></div>
</section>
<section class="drive-finder wrap"><div class="drive-finder-intro"><span class="drive-label">FIND YOUR NEXT</span><strong>What moves you?</strong></div> <form class="auction-search discovery-form" action="/inventory" method="get"><div class="search-query"><%- include('../partials/icons',{icon:'search'}) %><label class="sr-only" for="home-query">Search vehicles</label><input id="home-query" name="q" type="search" placeholder="Search make, model, or keyword…"></div><div><label class="sr-only" for="home-make">Make</label><select id="home-make" name="make"><option value="">All makes</option><% facets.makes.forEach(m=>{ %><option value="<%= m.make %>"><%= m.make %></option><% }); %></select></div><div><label class="sr-only" for="home-category">Category</label><select id="home-category" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select></div><button class="action action-dark" type="submit">Find vehicles <span aria-hidden="true">→</span></button></form>
</section>
<section class="drive-categories wrap" aria-label="Browse by body style"><a href="/inventory" class="drive-category-all">All vehicles ↗</a><% categories.slice(0,6).forEach(c=>{ %><a href="/inventory?category=<%= c.slug %>"><%- include('../partials/icons',{icon:c.icon || 'car'}) %><span><%= c.name %></span><small><%= c.listing_count %></small></a><% }); %></section>
<section class="auction-market" id="live-auctions"><div class="wrap"><div class="market-title"><div><span class="drive-label">THE CURRENT LINEUP</span><h2>Find your <em>next obsession.</em></h2></div><a class="link-arrow" href="/inventory">Explore all vehicles ↗</a></div> <div class="auction-toolbar"><div class="auction-tabs" aria-label="Filter featured auctions"><button type="button" class="is-active" data-auction-filter="all" aria-pressed="true">All auctions <span><%= shelf.length %></span></button><button type="button" data-auction-filter="ending" aria-pressed="false">Ending today</button><button type="button" data-auction-filter="no-reserve" aria-pressed="false">No reserve</button><button type="button" data-auction-filter="popular" aria-pressed="false">Most bids</button></div><span class="sync-label" data-auction-sync><span class="live-dot"></span> Auction overview</span></div>
 <% if(shelf.length) { %><div class="auction-grid market-grid" data-auction-grid><% shelf.forEach(lot=>{ %><%- include('../partials/auction-card',{lot}) %><% }); %></div><div class="filter-empty" hidden data-filter-empty><h3>No matching auctions in this selection.</h3><a href="/inventory" class="link-arrow">Explore the full inventory →</a></div><% } else { %><div class="filter-empty"><h3>No live auctions right now</h3><p>Browse available vehicles or sign up for new listing alerts.</p><a href="/inventory" class="action action-dark">Explore inventory</a></div><% } %>
 <div class="market-bottom"><p>Catalogue images may be representative. <a href="/photo-credits">Photography details</a></p><a href="/inventory?filter=auction" class="action action-outline">See all live auctions <span>↗</span></a></div>
</div></section>

<% if(cover){ %><section class="drive-feature wrap"><a class="drive-feature-photo" href="/lot/<%= cover.slug %>"><img src="/uploads/listings/<%= cover.primary_image %>" alt="<%= cover.title %> — representative catalogue photograph" loading="lazy" width="900" height="650"><span>IN FOCUS / <%= cover.year %></span></a><div class="drive-feature-copy"><span class="drive-label">A CLOSER LOOK</span><h2>Some cars just<br><em>stay with you.</em></h2><h3><%= cover.title %></h3><p>Get into the details. Explore the photos, specifications and condition information before you make your move.</p><div class="drive-feature-spec"><span><strong><%= Number(cover.mileage||0).toLocaleString('en-US') %></strong> miles</span><span><strong><%= cover.fuel_type || 'See listing' %></strong> fuel type</span></div><a class="drive-pill drive-pill-dark" href="/lot/<%= cover.slug %>">Meet this vehicle <span>↗</span></a></div></section><% } %>
<section class="drive-confidence"><div class="wrap"><div class="drive-confidence-heading"><span class="drive-label">THE AUTOBLOCK APPROACH</span><h2>More confidence.<br><em>Less guesswork.</em></h2><a href="/how-it-works">Get to know the process ↗</a></div><div class="drive-confidence-grid"><article><span>01 / KNOW YOUR VEHICLE</span><h3>Details come first.</h3><p>Photos, specifications and disclosed condition information. Take your time with the vehicle before you place a bid.</p></article><article><span>02 / MAKE YOUR MOVE</span><h3>Your bid. Your limit.</h3><p>Bid online, set a maximum, or buy outright. Review the buying terms and choose the route that works for you.</p></article><article><span>03 / ENJOY WHAT’S NEXT</span><h3>Support beyond the sale.</h3><p>Delivery coordination, digital agreements and a <%= brand.terms.inspectionDays %>-day inspection window. A team you can talk to along the way.</p></article></div><div class="drive-promise"><span><strong><%= brand.terms.buyerPremiumPercent %>%</strong> buyer premium</span><span><strong><%= brand.terms.inspectionDays %> days</strong> inspection window</span><span><strong><%= brand.terms.warrantyMonths %> months</strong> warranty</span><a href="/contact">Let’s talk about your next car ↗</a></div></div></section>
<section class="drive-help wrap"><div><span class="drive-label">A LITTLE CLARITY</span><h2>Before you<br><em>take the wheel.</em></h2><p>New to auctions? Start here.</p><a class="link-arrow" href="/faq">All your questions, answered ↗</a></div><div class="dealer-questions"><% homeFaq.slice(0,4).forEach((item,i)=>{ %><details <%= i===0?'open':'' %>><summary><%= item.q %><span aria-hidden="true">+</span></summary><p><%= item.a %></p></details><% }); %></div></section><section class="newsletter-section" id="alerts"><div class="wrap newsletter-inner"><div><span class="section-kicker">DON’T MISS YOUR NEXT OPPORTUNITY</span><h2>The next great find.<br>Before it gets away.</h2><p>Tell us what you’re looking for. We’ll keep you in the loop.</p></div><form method="post" action="/alerts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="wanted">What’s on your list?</label><input id="wanted" name="wanted" placeholder="e.g. A 4×4 pickup or weekend coupe"><label for="alert-email">Email address</label><div class="subscribe-row"><input id="alert-email" name="email" type="email" placeholder="you@example.com" required><button type="submit" class="action action-accent">Keep me posted ↗</button></div></form></div></section>

<%
/**
 * Home. The board still leads — but everything a first-time bidder needs
 * before they will commit now sits under it, in the running order the
 * reference auction sites use: search, stock, why, process, proof, questions.
 */
const lead   = endingSoon.length ? endingSoon[0] : null;
const rest   = endingSoon.slice(1, 7);
const shot   = endingSoon.find(function (l) { return l.primary_image; });
const second = endingSoon.filter(function (l) { return l.primary_image && l !== shot; })[0] || shot;
const avg    = reviews.length
  ? (reviews.reduce(function (sum, r) { return sum + r.rating; }, 0) / reviews.length).toFixed(1)
  : '5.0';
%>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="wrap hero-inner">
    <div>
      <span class="eyebrow" style="color:var(--hot)">
        <%= brand.address.city %>, <%= brand.address.state %> · <%= stats.live %> vehicles in stock
      </span>

      <h1 style="margin-top:12px">Bid. Buy.<br><span class="hl">Drive.</span></h1>

      <p class="lede">
        Trucks, SUVs, sedans and bikes — inspected, photographed honestly and
        sold to identity-verified bidders. Title included, delivered to your door
        anywhere in <%= brand.terms.deliveryRegion %>.
      </p>

      <div class="hero-cta">
        <a href="/inventory?filter=auction" class="btn btn-hot btn-lg btn-inline">
          <%- include('../partials/icons', { icon: 'gavel', strokeWidth: 2 }) %>
          Live auctions
        </a>
        <a href="/inventory" class="btn btn-outline-light btn-lg btn-inline">Browse inventory</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat"><div class="n"><%= stats.auctions %></div><div class="l">Live right now</div></div>
        <div class="hero-stat"><div class="n"><%= stats.live %></div><div class="l">Vehicles listed</div></div>
        <div class="hero-stat"><div class="n"><%= brand.terms.inspectionDays %> days</div><div class="l">Money back</div></div>
        <div class="hero-stat"><div class="n">No fee</div><div class="l">Buyer premium</div></div>
      </div>
    </div>

    <div class="hero-visual">
      <% if (shot) { %>
        <a href="/lot/<%= shot.slug %>">
          <img src="/uploads/listings/<%= shot.primary_image %>" alt="<%= shot.title %>" width="900" height="620">
        </a>
        <div class="hero-float">
          <div>
            <div class="k">Closing next</div>
            <div class="v"><%= shot.title %></div>
          </div>
          <div style="text-align:right">
            <div class="k">Current bid</div>
            <div class="v"><%= money.formatShort(shot.current_bid || shot.starting_bid) %></div>
            <div class="t" data-countdown="<%= shot.auction_ends_at %>">
              <span data-countdown-label><%= dates.countdown(shot.auction_ends_at).label %></span>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ================= TRUST ROW ================= -->
<div class="trustrow">
  <div class="wrap trustrow-inner">
    <span><%- include('../partials/icons', { icon: 'lock', strokeWidth: 2 }) %> SSL encrypted</span>
    <span><%- include('../partials/icons', { icon: 'cert', strokeWidth: 2 }) %> Licensed dealer</span>
    <span><%- include('../partials/icons', { icon: 'idcard', strokeWidth: 2 }) %> Verified members only</span>
    <span><%- include('../partials/icons', { icon: 'signature', strokeWidth: 2 }) %> Digital agreements</span>
    <span><%- include('../partials/icons', { icon: 'truck', strokeWidth: 2 }) %> Door-to-door delivery</span>
  </div>
</div>

<!-- ================= SEARCH ================= -->
<section class="section-sm">
  <div class="wrap">
    <form class="console" method="get" action="/inventory">
      <div class="console-head">
        <div>
          <h2 class="h3">Find your next vehicle</h2>
          <p class="small muted" style="margin-top:4px">
            Filter by year, make, body type, fuel, mileage and budget.
          </p>
        </div>
        <span class="tag tag-live"><span class="dot dot-pulse"></span> <%= stats.auctions %> auctions live right now</span>
      </div>

      <div class="console-grid">
        <div class="field">
          <label class="label" for="year_min">Year from</label>
          <select class="select" id="year_min" name="year_min">
            <option value="">Any</option>
            <% facets.years.forEach(function (y) { %><option value="<%= y %>"><%= y %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="make">Make</label>
          <select class="select" id="make" name="make">
            <option value="">All makes</option>
            <% facets.makes.forEach(function (m) { %>
              <option value="<%= m.make %>"><%= m.make %> (<%= m.n %>)</option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="category">Body type</label>
          <select class="select" id="category" name="category">
            <option value="">All types</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.slug %>"><%= c.name %> (<%= c.listing_count %>)</option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="fuel_type">Fuel</label>
          <select class="select" id="fuel_type" name="fuel_type">
            <option value="">Any fuel</option>
            <% (facets.fuels || []).forEach(function (f) { %>
              <option value="<%= f.fuel_type %>"><%= f.fuel_type %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="mileage_max">Max mileage</label>
          <select class="select" id="mileage_max" name="mileage_max">
            <option value="">Any mileage</option>
            <option value="30000">Under 30,000</option>
            <option value="60000">Under 60,000</option>
            <option value="100000">Under 100,000</option>
          </select>
        </div>
        <div class="field">
          <label class="label" for="price_max">Budget up to</label>
          <div class="input-money">
            <input class="input" type="text" inputmode="numeric" id="price_max" name="price_max" placeholder="60,000">
          </div>
        </div>
      </div>

      <div class="console-actions">
        <button type="submit" class="btn btn-dark btn-inline">
          <%- include('../partials/icons', { icon: 'search', strokeWidth: 2 }) %>
          Search vehicles
        </button>
        <a href="/inventory" class="btn btn-ghost btn-inline">View all inventory</a>
        <input class="input" type="search" name="q" placeholder="Or search by VIN or stock number"
               aria-label="Search by VIN" style="max-width:260px;margin-left:auto">
      </div>
    </form>
  </div>
</section>

<!-- ================= THE BOARD ================= -->
<section class="board" style="padding-top:8px">
  <div class="wrap">
    <div class="board-head">
      <h2>Ending soonest</h2>
      <span class="sort">
        Highest verified bid wins · no buyer premium ·
        <a href="/inventory?filter=auction" style="color:var(--hot)">all live lots →</a>
      </span>
    </div>

    <% if (endingSoon.length) { %>
      <div class="board-grid">
        <%- include('../partials/lot-card', { lot: lead, feature: true }) %>
        <% rest.forEach(function (lot) { %>
          <%- include('../partials/lot-card', { lot: lot }) %>
        <% }); %>
      </div>

      <div class="center mt-3">
        <a href="/inventory" class="btn btn-ghost btn-inline">
          Browse all <%= stats.live %> vehicles
          <%- include('../partials/icons', { icon: 'arrowR', strokeWidth: 2 }) %>
        </a>
      </div>
    <% } else { %>
      <div class="empty card">
        <%- include('../partials/icons', { icon: 'gavel', strokeWidth: 1.2 }) %>
        <h3 class="h3">No auctions running right now</h3>
        <p class="muted mt-1">New vehicles go up regularly — check back shortly.</p>
      </div>
    <% } %>
  </div>
</section>

<!-- ================= CATEGORIES ================= -->
<section class="section-sm section-white">
  <div class="wrap">
    <div class="row-between mb-2">
      <div>
        <span class="eyebrow">Browse by type</span>
        <h2 class="h3" style="margin-top:6px">What are you after?</h2>
      </div>
      <a href="/inventory" class="chip">All <%= stats.live %> vehicles →</a>
    </div>

    <div class="grid grid-4">
      <% categories.forEach(function (c) { %>
        <a href="/inventory?category=<%= c.slug %>" class="card card-pad card-hover cat-tile"
           style="display:flex;flex-direction:column;gap:10px;align-items:flex-start">
          <span style="color:var(--hot)">
            <%- include('../partials/icons', { icon: c.icon || 'car', strokeWidth: 1.5 }) %>
          </span>
          <span class="h4" style="font-size:1.02rem"><%= c.name %></span>
          <span class="mono xsmall muted"><%= c.listing_count %> available</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ================= WHY US ================= -->
<section class="section section-white">
  <div class="wrap">
    <div class="split">
      <% if (second) { %>
        <img src="/uploads/listings/<%= second.primary_image %>" alt="<%= second.title %>" loading="lazy" width="800" height="640">
      <% } %>
      <div class="split-body">
        <span class="eyebrow">Why <%= brand.shortName %></span>
        <h2 class="h2" style="margin:10px 0 14px">Built for buying<br>sight-unseen.</h2>
        <p class="lede" style="font-size:.98rem">
          Buying a car online only works if the seller removes the risk. So we
          did — inspection, verification, paperwork and delivery all sit on our
          side of the deal.
        </p>

        <ul class="ticks">
          <li><span class="box">✓</span><span>Every vehicle inspected and photographed as it actually sits — mileage, wear and faults included</span></li>
          <li><span class="box">✓</span><span>Title status disclosed before you bid and printed on your agreement</span></li>
          <li><span class="box">✓</span><span><%= brand.terms.inspectionDays %>-day money back — take it to your own mechanic</span></li>
        </ul>

        <div class="row" style="gap:9px">
          <a href="/about" class="btn btn-primary btn-inline">About us</a>
          <a href="/contact" class="btn btn-ghost btn-inline">Contact sales</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="section section-alt">
  <div class="wrap">
    <div class="row-between mb-3">
      <div>
        <span class="eyebrow">How it works</span>
        <h2 class="h2" style="margin-top:8px">From browsing<br>to your driveway</h2>
      </div>
      <a href="/how-it-works" class="btn btn-ghost btn-inline">Full process</a>
    </div>

    <div class="process">
      <% [
        { n: '01', t: 'Browse', d: 'Every listing carries photographs, mileage, title status, options and an honest description.' },
        { n: '02', t: 'Verify', d: 'Register free and clear ID once — front, back and a selfie. Cleared in hours.' },
        { n: '03', t: 'Bid or buy', d: 'Set a maximum and we bid for you in single increments, or take it now at the Buy Now price.' },
        { n: '04', t: 'Sign and drive', d: 'Your agreement is issued the second you bid, signed digitally, then delivered with the title.' }
      ].forEach(function (s) { %>
        <div class="pcard">
          <div class="n"><%= s.n %></div>
          <h3><%= s.t %></h3>
          <p><%= s.d %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ================= FEATURES ================= -->
<section class="section section-white">
  <div class="wrap">
    <div class="row-between mb-3">
      <div>
        <span class="eyebrow">Why <%= brand.shortName %></span>
        <h2 class="h2" style="margin-top:8px">The smarter way to buy</h2>
      </div>
      <a href="/how-it-works" class="btn btn-ghost btn-inline">How it works</a>
    </div>

    <div class="grid grid-3">
      <% [
        { icon: 'shield',    t: 'Inspected before listing',   d: 'Every vehicle goes through our shop and is photographed as it actually sits.' },
        { icon: 'gavel',     t: 'Live timed bidding',         d: 'Anti-snipe protection extends any lot bid on in its final minutes, so nothing is stolen at the buzzer.' },
        { icon: 'tag',       t: 'Buy it now',                 d: 'Do not want to wait for the clock? Take it outright at a fixed price, any time.' },
        { icon: 'idcard',    t: 'Identity-verified bidders',  d: 'Every bidder clears ID before their first bid. No ghost accounts inflating the price.' },
        { icon: 'car',       t: 'Cars, trucks, SUVs and bikes', d: 'One account, one process, whatever you are shopping for.' },
        { icon: 'signature', t: 'Contract the moment you bid', d: 'Pre-filled with your details and the VIN, sent for signature immediately.' },
        { icon: 'lock',      t: 'Secure by default',          d: 'Encrypted checkout, bank wire settlement and documents stored against your account.' },
        { icon: 'file',      t: 'Title always included',      d: 'Clean, rebuilt or salvage — disclosed before you bid, never a surprise afterwards.' },
        { icon: 'rotate',    t: brand.terms.inspectionDays + '-day money back', d: 'Not as described? We collect at our cost and refund in ' + brand.terms.refundWindowHours + ' hours.' }
      ].forEach(function (f) { %>
        <div class="value-card">
          <span class="feature-mark" style="color:var(--hot);display:block">
            <%- include('../partials/icons', { icon: f.icon, strokeWidth: 1.6 }) %>
          </span>
          <h3 class="h4" style="font-size:1.02rem;margin:12px 0 8px"><%= f.t %></h3>
          <p class="muted small" style="line-height:1.6"><%= f.d %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ================= REVIEWS ================= -->
<section class="section section-alt">
  <div class="wrap">
    <div class="row-between mb-3">
      <div>
        <span class="eyebrow">Verified buyers</span>
        <h2 class="h2" style="margin-top:8px">What buyers say</h2>
      </div>
      <div class="row" style="gap:16px">
        <div class="rating-sum">
          <span class="score"><%= avg %></span>
          <div>
            <div class="stars">
              <% for (let i = 0; i < 5; i++) { %><%- include('../partials/icons', { icon: 'star', strokeWidth: 0 }) %><% } %>
            </div>
            <div class="mono xsmall muted"><%= reviews.length %>+ verified purchases</div>
          </div>
        </div>
        <a href="/reviews" class="btn btn-ghost btn-inline">All reviews</a>
      </div>
    </div>

    <div class="grid grid-3">
      <% reviews.forEach(function (r) { %>
        <div class="review-card">
          <div class="stars">
            <% for (let i = 0; i < r.rating; i++) { %><%- include('../partials/icons', { icon: 'star', strokeWidth: 0 }) %><% } %>
          </div>
          <p class="review-body">“<%= r.body %>”</p>
          <div class="review-item">
            <%- include('../partials/icons', { icon: 'car', strokeWidth: 1.7 }) %>
            <%= r.item %>
          </div>
          <div class="review-who">
            <%- include('../partials/avatar', { person: r }) %>
            <div>
              <div class="small" style="font-weight:600"><%= r.name %></div>
              <div class="mono xsmall muted"><%= r.location %></div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ================= COMMON QUESTIONS ================= -->
<section class="section section-white">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:34px;align-items:start">
      <div>
        <span class="eyebrow">Before you bid</span>
        <h2 class="h2" style="margin:8px 0 14px">Common<br>questions</h2>
        <p class="lede">
          Bidding, verification, payment, the <%= brand.terms.inspectionDays %>-day
          inspection window, titles and delivery.
        </p>
        <a href="/faq" class="btn btn-primary mt-3 btn-inline">Read the full FAQ</a>
      </div>

      <div class="card card-pad">
        <% homeFaq.forEach(function (item, i) { %>
          <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
            <summary class="faq-q">
              <%= item.q %>
              <span class="icon"><%- include('../partials/icons', { icon: 'plus', strokeWidth: 2.4 }) %></span>
            </summary>
            <div class="faq-a"><%= item.a %></div>
          </details>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<!-- ================= ALERTS ================= -->
<section class="alerts" id="alerts">
  <div class="wrap">
    <div>
      <h3>Tell us what you are hunting for</h3>
      <p>We email you the moment a matching vehicle is listed — before it opens for bidding.</p>
    </div>
    <form method="post" action="/alerts" class="row">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input class="input" type="text" name="wanted" placeholder="e.g. 4x4 diesel pickup under 80,000 miles"
             aria-label="What you are looking for" style="min-width:300px">
      <input class="input" type="email" name="email" placeholder="you@email.com" aria-label="Email address" required>
      <button type="submit" class="btn btn-hot btn-inline">Get alerts</button>
    </form>
  </div>
</section>
